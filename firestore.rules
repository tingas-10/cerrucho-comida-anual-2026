rules_version = '2';

// Reglas de seguridad de Firestore para La Banda del cerrucho.
// La UI no es una barrera de permisos: estas reglas son las que protegen los datos.
// Roles: visitante (sin sesión, sólo lee lo público) · miembro · presidente (confirma fecha, lugar y comida)
// · administrador (role 'owner'). Los resultados de premios los lee SOLO el miembro 'owner' (Agus).
// Publicar con: npx firebase-tools deploy --only firestore:rules --project cerrucho-comida-anual-2026

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function hasLink() {
      return signedIn() && exists(/databases/$(database)/documents/uids/$(request.auth.uid));
    }
    function myId() {
      return get(/databases/$(database)/documents/uids/$(request.auth.uid)).data.memberId;
    }
    function myMember() {
      return get(/databases/$(database)/documents/members/$(myId())).data;
    }
    function isActive() {
      return hasLink() && myMember().status == 'active';
    }
    function isAdmin() {
      return isActive() && myMember().role == 'owner';
    }
    // Sólo Agus: resultados de premios. No se extiende a otros administradores.
    function isAgus() {
      return isActive() && myId() == 'owner';
    }
    function isPresident() {
      return isActive() && exists(/databases/$(database)/documents/config/roles)
        && get(/databases/$(database)/documents/config/roles).data.presidentId == myId();
    }
    function now() {
      return request.time.toMillis();
    }
    function onlyKeys(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- Cuentas y perfiles ----------
    // Perfil público: alias, nombre, foto, cumpleaños (día y mes) y gustos para el regalo.
    match /members/{memberId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isActive() && memberId == myId()
            && onlyKeys(['alias', 'avatarColor', 'photo', 'birthday', 'giftPrefs', 'profileDone', 'updatedAt'])
            && (!('photo' in request.resource.data) || request.resource.data.photo == null || request.resource.data.photo.size() < 80000)
            && (!('giftPrefs' in request.resource.data) || request.resource.data.giftPrefs.size() <= 600)
            && (!('alias' in request.resource.data) || (request.resource.data.alias.size() >= 2 && request.resource.data.alias.size() <= 24)));
    }

    // Privado: usuario, cuenta vigente y año de nacimiento. Nunca hay contraseñas acá.
    match /memberPrivate/{memberId} {
      allow read: if isAdmin() || (isActive() && memberId == myId());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isActive() && memberId == myId() && onlyKeys(['birthYear', 'updatedAt']));
    }

    // Vínculo cuenta → miembro. Lo escribe sólo el administrador al crear o resetear un acceso.
    match /uids/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Usuario → mail interno, para poder entrar con usuario y contraseña. Se consulta de a uno, no se lista.
    match /logins/{username} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reactions/{reactionId} {
      allow read: if true;
      allow create, update: if isActive() && request.resource.data.memberId == myId()
        && reactionId == request.resource.data.photoId + '_' + myId();
      allow delete: if isActive() && resource.data.memberId == myId();
    }

    match /archive/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- FMO (fútbol): cualquiera mira, los miembros cargan y editan ----------
    match /fmoMatches/{matchId} {
      allow read: if true;
      allow write: if isActive();
    }
    match /fmoGuests/{guestId} {
      allow read: if true;
      allow write: if isActive();
    }
    // ---------- Golf ----------
    // La comisión (config/roles.golfCommission) decide con propuestas: se aplican sólo con 2 aprobaciones.
    function golfComm() {
      return get(/databases/$(database)/documents/config/roles).data.get('golfCommission', []);
    }
    function isGolfComm() {
      return isActive() && myId() in golfComm();
    }
    function gprop(pid) {
      return get(/databases/$(database)/documents/golfProposals/$(pid)).data;
    }
    function approvedProp(pid, type) {
      let p = gprop(pid);
      return p.status == 'OPEN' && p.type == type && p.approvals.size() >= 2;
    }

    match /golfProposals/{pid} {
      allow read: if true;
      allow create: if isGolfComm()
        && request.resource.data.proposedBy == myId()
        && request.resource.data.status == 'OPEN'
        && request.resource.data.approvals.keys().hasOnly([myId()])
        && request.resource.data.rejections.size() == 0;
      allow update: if isGolfComm() && resource.data.status == 'OPEN' && (
        // votar: cada uno sólo agrega o cambia su propio voto
        (onlyKeys(['approvals', 'rejections', 'updatedAt'])
          && request.resource.data.approvals.diff(resource.data.approvals).affectedKeys()
               .union(request.resource.data.rejections.diff(resource.data.rejections).affectedKeys()).hasOnly([myId()]))
        // aplicar: con 2 aprobaciones
        || (resource.data.approvals.size() >= 2 && request.resource.data.status == 'APPLIED'
          && onlyKeys(['status', 'appliedAt', 'appliedBy', 'updatedAt']))
        // rechazar (2 rechazos) o retirar (quien la propuso)
        || (onlyKeys(['status', 'updatedAt'])
          && ((request.resource.data.status == 'REJECTED' && resource.data.rejections.size() >= 2)
            || (request.resource.data.status == 'WITHDRAWN' && resource.data.proposedBy == myId())))
      );
      allow delete: if isAdmin();
    }

    match /config/golf {
      allow read: if true;
      allow write: if isAdmin() || (isGolfComm()
        && approvedProp(request.resource.data.lastProposal, 'points')
        && request.resource.data.points == gprop(request.resource.data.lastProposal).payload.points);
    }

    match /golfCourses/{cid} {
      allow read: if true;
      allow create, update: if isAdmin() || (isGolfComm()
        && approvedProp(request.resource.data.lastProposal, 'course')
        && gprop(request.resource.data.lastProposal).payload.courseId == cid
        && request.resource.data.name == gprop(request.resource.data.lastProposal).payload.name
        && request.resource.data.holes == gprop(request.resource.data.lastProposal).payload.holes
        && request.resource.data.archived == gprop(request.resource.data.lastProposal).payload.archived);
      allow delete: if isAdmin();
    }

    // Hándicap: cada uno el suyo y el de los invitados; el de otro miembro, la comisión.
    match /golfPlayers/{pid} {
      allow read: if true;
      allow write: if isAdmin()
        || (isActive() && (pid == myId() || pid.matches('g-.*')))
        || (isGolfComm()
          && approvedProp(request.resource.data.lastProposal, 'hcp')
          && gprop(request.resource.data.lastProposal).payload.playerId == pid
          && request.resource.data.hcp == gprop(request.resource.data.lastProposal).payload.hcp);
    }

    // Desafíos: desafía alguien que juega; acepta o rechaza el desafiado; cancela quien desafió.
    match /golfChallenges/{cid} {
      allow read: if true;
      allow create: if isActive()
        && request.resource.data.createdBy == myId()
        && myId() in request.resource.data.challengers
        && request.resource.data.status == 'PENDING'
        && request.resource.data.mode in ['match', 'fourball'];
      allow update: if isActive() && resource.data.status == 'PENDING'
        && request.resource.data.challengers == resource.data.challengers
        && request.resource.data.challenged == resource.data.challenged
        && ((myId() in resource.data.challenged && request.resource.data.status in ['ACCEPTED', 'DECLINED'])
          || (myId() in resource.data.challengers && request.resource.data.status == 'CANCELLED'));
      allow delete: if isAdmin();
    }

    // Rondas: cualquiera de la banda las arma. Jugadas, se corrigen durante 48 h; después, la comisión.
    match /golfRounds/{rid} {
      allow read: if true;
      allow create: if isActive() && request.resource.data.status == 'DRAFT' && request.resource.data.get('voided', false) == false;
      allow update: if (isActive()
          && request.resource.data.get('voided', false) == resource.data.get('voided', false)
          && (resource.data.status == 'DRAFT'
            ? (request.resource.data.status == 'DRAFT'
              || (request.resource.data.status == 'PLAYED' && request.resource.data.editableUntil is int
                && request.resource.data.editableUntil <= now() + 173100000))
            : (now() < resource.data.editableUntil
              && request.resource.data.status == 'PLAYED'
              && request.resource.data.editableUntil == resource.data.editableUntil)))
        || (isGolfComm()
          && ((approvedProp(request.resource.data.lastProposal, 'round_fix')
              && gprop(request.resource.data.lastProposal).payload.roundId == rid
              && request.resource.data.cards == gprop(request.resource.data.lastProposal).payload.cards)
            || (approvedProp(request.resource.data.lastProposal, 'round_void')
              && gprop(request.resource.data.lastProposal).payload.roundId == rid
              && request.resource.data.voided == true)));
      allow delete: if isAdmin() || (isActive() && resource.data.status == 'DRAFT');
    }

    // ---------- Pádel: igual que FMO (los invitados son los mismos de fmoGuests) ----------
    match /padelMatches/{matchId} {
      allow read: if true;
      allow delete: if isActive();
      allow create, update: if isActive()
        && request.resource.data.bestOf in [1, 3, 5]
        && request.resource.data.status in ['DRAFT', 'PLAYED']
        && request.resource.data.pairA.size() == 2
        && request.resource.data.pairB.size() == 2;
    }

    // ---------- Edición anual ----------
    match /editions/{slug} {
      allow read: if true;
      allow write: if isAdmin();
      // El presidente confirma fecha, lugar y comida.
      allow update: if isPresident() && onlyKeys(['date', 'venue', 'menu', 'decisions', 'planVersion', 'state', 'news', 'updatedAt']);

      function edition() {
        return get(/databases/$(database)/documents/editions/$(slug)).data;
      }

      match /polls/{pollId} {
        allow read: if true;
        allow write: if isAdmin();
        allow update: if isPresident() && onlyKeys(['decision', 'updatedAt']);

        function poll() {
          return get(/databases/$(database)/documents/editions/$(slug)/polls/$(pollId)).data;
        }

        match /responses/{memberId} {
          allow read: if true;
          allow create, update: if isActive() && memberId == myId()
            && poll().state == 'OPEN'
            && (poll().closeAt == null || now() < poll().closeAt)
            && (poll().electorateMode == 'ALL_ACTIVE' || myId() in poll().electorate);
          allow delete: if false;
        }
      }

      // Propuestas de lugar, comida y salida: pasan directo a votación (👍/👎).
      match /proposals/{proposalId} {
        allow read: if true;
        allow create: if isActive() && request.resource.data.authorId == myId() && request.resource.data.state == 'PENDING';
        allow update: if isAdmin()
          // Voto: cada miembro sólo toca su propia clave en `votes`
          || (isActive() && onlyKeys(['votes', 'updatedAt'])
              && request.resource.data.votes.diff(resource.data.get('votes', {})).affectedKeys().hasOnly([myId()]))
          // El autor puede retirarla
          || (isActive() && resource.data.authorId == myId() && onlyKeys(['state', 'updatedAt']) && request.resource.data.state == 'WITHDRAWN');
        allow delete: if isAdmin();
      }

      match /rsvps/{memberId} {
        allow read: if true;
        allow write: if isActive() && memberId == myId();
      }

      match /beverages/{memberId} {
        allow read: if isActive();
        allow write: if isActive() && memberId == myId() && edition().beverage.state == 'OPEN';
      }

      match /checklists/{memberId} {
        allow read, write: if isActive() && memberId == myId();
      }

      // ---------- Premios: se vota dentro del período; los resultados sólo los ve Agus ----------
      match /awards/{code} {
        allow read: if true;
        allow write: if isAdmin();

        function award() {
          return get(/databases/$(database)/documents/editions/$(slug)/awards/$(code)).data;
        }
        function inWindow(r) {
          return r != null && r.get('openAt', 0) <= now() && now() < r.closeAt;
        }
        function validR1() {
          return request.resource.data.r1 == 'NOBODY' || request.resource.data.r1 in award().candidates;
        }
        function validR2() {
          return request.resource.data.r2 in award().finalists;
        }
        function round1Open() {
          return award().state == 'ROUND1_OPEN' && inWindow(award().round1) && validR1();
        }
        function round2Open() {
          return award().state == 'ROUND2_OPEN' && inWindow(award().round2) && validR2();
        }

        match /ballots/{memberId} {
          // Cada uno ve sólo su boleta. Para contar, sólo Agus.
          allow read: if isAgus() || (isActive() && memberId == myId());
          // Boleta nueva: sólo el voto de la ronda abierta (la otra queda vacía).
          allow create: if isActive() && memberId == myId() && myId() in award().electorate
            && (
              (round1Open() && request.resource.data.get('r2', null) == null)
              || (round2Open() && request.resource.data.get('r1', null) == null)
            );
          // Cambio de voto: sólo se toca la ronda abierta; la otra queda como estaba.
          allow update: if isActive() && memberId == myId() && myId() in award().electorate
            && (
              (round1Open() && request.resource.data.get('r2', null) == resource.data.get('r2', null))
              || (round2Open() && request.resource.data.get('r1', null) == resource.data.get('r1', null))
            );
          allow delete: if false;
        }

        match /private/{doc} {
          allow read, write: if isAgus();
        }
      }

      // ---------- Amigo invisible: participan todos; cada uno ve sólo a quién le regala ----------
      match /gift/{doc} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /giftAssignments/{giverId} {
        allow read: if isAdmin() || (isActive() && giverId == myId());
        allow write: if isAdmin();
      }

      // ---------- Organización (sólo miembros) ----------
      match /tasks/{taskId} {
        allow read: if isActive();
        allow create, delete: if isAdmin();
        allow update: if isAdmin()
          || (isActive() && resource.data.status == 'OPEN'
              && onlyKeys(['volunteers', 'updatedAt'])
              && request.resource.data.volunteers.diff(resource.data.volunteers).affectedKeys().hasOnly([myId()])
              && request.resource.data.volunteers.size() <= resource.data.capacity);
      }

      match /transport/{entryId} {
        allow read: if isActive();
        allow create: if isActive() && request.resource.data.memberId == myId();
        allow update, delete: if isAdmin() || (isActive() && resource.data.memberId == myId());
      }

      match /audit/{entryId} {
        allow read: if isAdmin();
        allow create: if isActive() && request.resource.data.actorId == myId();
        allow update, delete: if false;
      }

      // Lo que no aparece acá (gastos, ceremonia, inscripción al regalo, restricciones) queda cerrado por defecto.
    }
  }
}
